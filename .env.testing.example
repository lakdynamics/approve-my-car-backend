# Copy to .env.testing and fill in APP_KEY and DB_PASSWORD.
# Tests wipe their database on every run, so DB_DATABASE must be a
# separate database whose name ends in _test (tests/TestCase.php checks).
# Give the test user rights on the test database only.

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vehicle_inspection_test
DB_USERNAME=vehicle_app_test
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
